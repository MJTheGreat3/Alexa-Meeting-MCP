PORT=3333

# Linear: Settings -> API -> Personal API keys
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Notion: https://www.notion.so/my-integrations -> create integration -> share a page with it
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Slack: https://api.slack.com/apps -> your app -> OAuth & Permissions -> Bot Token
# Scopes needed: chat:write, channels:read, groups:read, users:read
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

MCP_SERVER_URL=http://localhost:3333/mcp

# Groq: https://console.groq.com/keys (free, no card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Route B web simulator
WEBAPP_PORT=3334
